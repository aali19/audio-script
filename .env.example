# Application
AUDIO_APP_NAME=Audio Transcription API

# Upload and validation limits
AUDIO_MAX_UPLOAD_BYTES=524288000
AUDIO_MAX_DURATION_SECONDS=14400
AUDIO_UPLOAD_CHUNK_SIZE=1048576
AUDIO_FFPROBE_PATH=ffprobe
AUDIO_FFPROBE_TIMEOUT_SECONDS=30

# Uncomment to use a specific temporary-file directory.
# AUDIO_TEMP_DIRECTORY=./tmp

# Faster-Whisper
AUDIO_WHISPER_MODEL=small
AUDIO_WHISPER_DEVICE=cpu
AUDIO_WHISPER_COMPUTE_TYPE=int8
AUDIO_WHISPER_BEAM_SIZE=5

# Uncomment to use a persistent model cache directory.
# AUDIO_WHISPER_DOWNLOAD_ROOT=./models

# Per-process inference capacity
AUDIO_TRANSCRIPTION_CONCURRENCY=1
AUDIO_TRANSCRIPTION_ACQUIRE_TIMEOUT_SECONDS=1
